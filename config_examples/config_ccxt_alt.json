{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 6,
    "stake_currency": "USDT",
    "stake_amount": 80,
    "tradable_balance_ratio": 1,
    "fiat_display_currency": "USD",
    "dry_run": false,
    "dry_run_wallet": 12000,
    "timeframe": "1h",
    "cancel_open_orders_on_exit": true,
    "use_exit_signal": true,
    "exit_profit_only": false,
    "futures_funding_rate": 0,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "enableRateLimit": true,
            "urls": {
                "api": {
                    "public": "https://testnet.binancefuture.com/fapi/v1",
                    "private": "https://testnet.binancefuture.com/fapi/v1"
                }
            }
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "XRP/USDT:USDT",
            "ADA/USDT:USDT",
            "DOGE/USDT:USDT",
            "AVAX/USDT:USDT",
            "LINK/USDT:USDT",
            "DOT/USDT:USDT",
            "MATIC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "api_server": {
        "enabled": false
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "emergency_exit": "market",
        "force_exit": "market",
        "force_entry": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    },
    "strategy": "CcxtSegmentedStrategyAI",
    "strategy_path": "user_data/strategies",
    "ai_iteration": {
        "enabled": true,
        "segment": "alt",
        "threshold_offsets": {
            "rsi_long": 2,
            "rsi_short": -2,
            "macd_hist": 0.002,
            "ema_diff": 0.0005,
            "atr_pct": 0.001,
            "volume_zscore": 0.2
        },
        "state_file": "user_data/ai_iteration_state_alt.json",
        "feedback_file": "user_data/ai_iteration_feedback_alt.jsonl",
        "min_trades": 12,
        "profit_threshold": 0.0,
        "refresh_minutes": 20
    },
    "bot_name": "freqtrade-alt",
    "db_url": "sqlite:///user_data/trades_ccxt_alt.sqlite",
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    }
}
